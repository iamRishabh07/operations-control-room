{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test-acquire)",
      "Bash(make acquire)",
      "Bash(make acquire-monthly)",
      "Bash(python3 scripts/acquire.py*)",
      "Bash(python3 -m unittest*)",
      "Bash(go test ./...)",
      "Bash(go test ./... *)",
      "Bash(go vet ./...)",
      "Bash(gofmt -w *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm test*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -*f*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use_policy.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "ponytail@ponytail": true
  }
}
